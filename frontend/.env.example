# Copy this file to .env and fill in real values. Never commit .env.
#
# Only PUBLIC keys belong in this file. Anything with a VITE_ prefix is
# compiled into the browser bundle and is visible to anyone who loads the site.

# --- Supabase -----------------------------------------------------------------
# Project settings -> API in the Supabase dashboard.
# The anon key is safe to publish: Row Level Security governs what it can read.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# NEVER put SUPABASE_SERVICE_ROLE_KEY here — it bypasses Row Level Security.
