# Copy this file to .env and fill in real values.

PORT=4000
FRONTEND_URL=http://localhost:3000

# Signing secret for our own session JWTs — any long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Firebase Admin SDK — verifies the phone-OTP sign-in the frontend performs
# with Firebase Auth, so login/registration is real phone-number auth.
# 1. https://console.firebase.google.com -> Create project
# 2. Build -> Authentication -> Sign-in method -> enable "Phone"
# 3. Project settings (gear icon) -> Service accounts -> Generate new private key
#    This downloads a JSON file — copy the three fields below from it.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Paste the private_key value from the JSON file as-is (keep the \n sequences literal).
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"

# SendGrid (https://sendgrid.com) sends a welcome email after phone signup.
# Optional — if unset, the server just logs the email to the console instead.
# 1. Sign up free at sendgrid.com
# 2. Settings -> Sender Authentication -> Verify a Single Sender
# 3. Settings -> API Keys -> Create API Key
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=your-verified-sender@example.com
