# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Origins allowed to call this API with credentials. Comma-separated; falls back
# to FRONTEND_URL. Must be https:// in production, and "*" is rejected outright
# because it cannot be combined with cookie authentication.
# CORS_ORIGINS=https://arogyasetu.example.com,https://www.arogyasetu.example.com

# Signing secret for this app's own session cookies (any long random string).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In production the server refuses to start if this is under 32 characters.
JWT_SECRET=change-me-to-a-long-random-string

# Session lifetime in days. Long by default because field workers on poor
# connectivity should not be logged out mid-visit; shorten it for deployments
# handling higher-sensitivity data.
SESSION_TTL_DAYS=7

# Serves Swagger UI at /api/docs and the raw spec at /api/openapi.json.
# On by default in development, off in production: the spec is a complete map
# of every endpoint and payload shape.
# ENABLE_API_DOCS=false

# --- Two-factor authentication ------------------------------------------------
# TOTP is REQUIRED for ADMIN, DOCTOR, SPECIALIST and ASHA accounts and optional
# for patients. Enrolment is enforced server-side by middleware/mfaGate.js, so
# there is no flag to turn it off — change MFA_REQUIRED_ROLES in
# src/services/mfaService.js if the policy needs to differ.
#
# Enable the TOTP factor in the Supabase dashboard first:
#   Authentication -> Providers -> Multi-Factor Authentication -> TOTP.
# Without it, enrolment fails and staff cannot sign in.

# --- Supabase -----------------------------------------------------------------
# Project settings -> API in the Supabase dashboard.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# SECURITY: the service-role key bypasses Row Level Security completely.
# Server-side only. Never expose it to the browser and never give it a
# VITE_ / NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Local database (current implementation) ----------------------------------
# The running backend still uses SQLite; see README "Migration status".
DATABASE_URL=arogyasetu.sqlite

# --- Direct Postgres connection (only needed to run schema migrations) --------
# Settings -> Database -> Connection string -> URI.
# URL-encode special characters in the password (@ -> %40, # -> %23).
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# --- AI provider (server-side only; never exposed to the browser) -------------
# Powers the clinical assistant. Without a key the assistant still answers, but
# only from the built-in knowledge base in src/services/ai/knowledgeBase.js.
#
# gemini -> GEMINI_API_KEY from https://aistudio.google.com/apikey
# openai -> OPENAI_API_KEY from https://platform.openai.com/api-keys
# none   -> knowledge base only; a deliberate choice, not a missing key.
#
# In production the server refuses to boot if AI_PROVIDER names a provider
# whose key is absent, so a typo cannot silently disable the assistant.
#
# On a deployment, set these as environment variables in the hosting platform
# (Render/Railway/Fly/etc.) — this file is not deployed, and .env is gitignored.
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Email (optional; logs to console when unset) ----------------------------
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# --- File storage -------------------------------------------------------------
STORAGE_PROVIDER=local
# Shared password for generated demo accounts. Optional — a random one is used if unset.
DEMO_PASSWORD=
