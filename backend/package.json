{
  "name": "backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node src/db/cli.js migrate",
    "db:seed": "node src/db/cli.js seed",
    "db:reset": "node src/db/cli.js reset",
    "test": "vitest run",
    "test:watch": "vitest",
    "supabase:migrate": "node scripts/supabase-migrate.js",
    "supabase:check": "node scripts/supabase-migrate.js --check",
    "supabase:verify": "node scripts/supabase-verify.js",
    "supabase:rls-test": "node scripts/supabase-rls-test.js",
    "test:smtp": "node scripts/test-smtp.js",
    "demo:accounts": "node scripts/create-demo-accounts.js",
    "demo:data": "node scripts/seed-demo-data.js",
    "demo:full": "npm run demo:accounts && npm run demo:data && npm run demo:scale && npm run demo:link",
    "demo:history": "node scripts/seed-history.js",
    "demo:scale": "node scripts/seed-scale.js",
    "demo:link": "node scripts/link-demo-data.js",
    "grant-role": "node scripts/grant-role.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "supertest": "^7.2.2",
    "vitest": "^4.1.11"
  }
}